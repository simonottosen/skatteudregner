# Supabase — copy this file to ".env.local" and fill in the values from your
# Supabase project: Project Settings → API.
#
# Until these are set, the app runs fine anonymously (localStorage) and the
# login UI shows a "not configured" notice.
#
# The MCP server at /api/mcp reuses these same two variables — it authenticates
# each request with the user's own email/password (HTTP Basic) and needs no
# extra/service-role secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
